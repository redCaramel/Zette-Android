<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zette" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Color -->
        <item name="colorPrimary">@color/green_brand</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/green_mint</item>
        <item name="colorOnPrimaryContainer">@color/green_deep</item>
        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/green_mint</item>
        <item name="colorOnSecondaryContainer">@color/green_deep</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/surface_canvas</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_ceramic</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_cool</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_ceramic</item>

        <!-- Line -->
        <item name="colorOutline">@color/border_input</item>
        <item name="colorOutlineVariant">@color/border_hairline</item>

        <!-- Error -->
        <item name="colorError">@color/semantic_error</item>
        <item name="colorOnError">@color/text_on_error</item>

        <!-- System Bar -->
        <item name="android:statusBarColor">@color/surface_canvas</item>
        <item name="android:navigationBarColor">@color/surface_canvas</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="android:textViewStyle">@style/Widget.Zette.TextView</item>

        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Zette.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Zette.H1</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Zette.H2</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Zette.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Zette.Subtitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Zette.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Zette.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Zette.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Zette.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Zette.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Zette.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Zette.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Zette.Large</item>
    </style>

    <style name="Widget.Zette.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Zette.Body</item>
    </style>

    <style name="ShapeAppearance.Zette.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="ShapeAppearance.Zette.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="ShapeAppearance.Zette.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="Widget.Zette.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_mint</item>
    </style>

    <style name="Widget.Zette.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="android:minHeight">@dimen/space_8</item>
        <item name="android:minWidth">@dimen/space_7</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">@dimen/space_2</item>
        <item name="iconTint">@color/fab_extended_content</item>
        <item name="android:textColor">@color/fab_extended_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Zette.Button</item>
        <item name="backgroundTint">@color/fab_extended_background</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zette.Full</item>
        <item name="android:elevation">@dimen/fab_elevation</item>
        <item name="android:stateListAnimator">@animator/floating_button_press_animator</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.Zette.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Zette.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/switch_track_decoration</item>
        <item name="thumbTint">@color/switch_thumb</item>
    </style>

    <style name="Widget.Zette.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Zette.Label</item>
        <item name="checkedIcon">@drawable/ic_check</item>
        <item name="checkedIconTint">@color/green_brand</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="Widget.Zette.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/green_accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Zette.Button</item>
        <item name="cornerRadius">@dimen/radius_full</item>
    </style>

    <style name="ShapeAppearance.Zette.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="Widget.Zette.Button.Dialog.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Zette.ButtonSmall</item>
    </style>

    <style name="Widget.Zette.Button.Dialog.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/green_brand</item>
        <item name="android:textAppearance">@style/TextAppearance.Zette.ButtonSmall</item>
    </style>

    <style name="ThemeOverlay.Zette.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/green_brand</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/border_hairline</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Zette.Dialog</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Zette.H1</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Zette.Subtitle</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Zette.Body</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Zette.Button.Dialog.Negative</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Zette.Button.Dialog.Positive</item>
    </style>

    <style name="ThemeOverlay.Zette.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/green_brand</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/green_mint</item>
        <item name="colorOnPrimaryContainer">@color/green_deep</item>
        <item name="colorTertiaryContainer">@color/green_mint</item>
        <item name="colorOnTertiaryContainer">@color/green_deep</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_ceramic</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_input</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Zette.Dialog</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Zette.Medium</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Zette.Display</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Zette.Body</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Zette.Button.Dialog.Negative</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Zette.Button.Dialog.Positive</item>
    </style>

    <style name="Theme.Zette.Splash" parent="Theme.Zette" />
</resources>
