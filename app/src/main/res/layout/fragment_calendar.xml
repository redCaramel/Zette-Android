<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:clipToPadding="false"
    android:paddingBottom="88dp"
    tools:context=".ui.CalendarFragment">

    <LinearLayout
        android:id="@+id/layout_calendar_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_date_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_container"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_month_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/calendar_toggle_month"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_2">

                    <TextView
                        android:id="@+id/tv_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Zette.Title"
                        android:textColor="@color/text_primary"
                        tools:text="10월" />

                    <ImageView
                        android:id="@+id/iv_month_toggle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_1"
                    android:text="@string/calendar_today"
                    android:textAppearance="@style/TextAppearance.Zette.Label"
                    android:textColor="@color/green_brand" />

                <LinearLayout
                    android:id="@+id/layout_month_nav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btn_prev_month"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/calendar_prev_month"
                        app:srcCompat="@drawable/ic_chevron_left"
                        app:tint="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/btn_next_month"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/calendar_next_month"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="7"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_date_cell"
                tools:spanCount="7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2">

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zette.H2"
                android:textColor="@color/text_primary"
                tools:text="10월 9일 (금)" />

            <TextView
                android:id="@+id/tv_event_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zette.Caption"
                android:textColor="@color/text_secondary"
                tools:text="일정 4개" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_calendar_event" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
