<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:id="@+id/icon_wrap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_round_full"
        android:backgroundTint="@color/green_mint">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/green_brand" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Zette.Subtitle"
            android:textColor="@color/text_primary"
            tools:text="알림" />

        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Zette.Caption"
            android:textColor="@color/text_secondary"
            tools:text="출발 알림을 보내요" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_allow"
        style="@style/Widget.Zette.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:minHeight="36dp"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:text="@string/perm_allow"
        android:textAppearance="@style/TextAppearance.Zette.ButtonSmall"
        android:textColor="@color/fab_extended_content"
        app:backgroundTint="@color/fab_extended_background" />

    <LinearLayout
        android:id="@+id/layout_granted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/space_1"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_check_circle"
            app:tint="@color/green_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:text="@string/perm_granted"
            android:textAppearance="@style/TextAppearance.Zette.Label"
            android:textColor="@color/green_brand" />
    </LinearLayout>
</LinearLayout>
