<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_lg"
    android:backgroundTint="@color/surface_raised"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/buffer_custom_title"
        android:textAppearance="@style/TextAppearance.Zette.Title"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Zette.Body"
        android:textColor="@color/text_secondary"
        tools:text="도착 시각보다 몇 분 일찍 도착할지 정해 주세요.\n이 루틴에만 적용돼요." />

    <include
        android:id="@+id/stepper"
        layout="@layout/view_buffer_stepper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_2"
        android:text="@string/buffer_range_hint"
        android:textAppearance="@style/TextAppearance.Zette.Caption"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply"
        style="@style/Widget.Zette.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/buffer_apply" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:text="@string/picker_cancel"
        android:textAppearance="@style/TextAppearance.Zette.ButtonSecondary"
        android:textColor="@color/green_accent"
        app:cornerRadius="@dimen/radius_full"
        app:strokeColor="@color/green_accent" />
</LinearLayout>
