<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical"
    tools:context=".ui.activity.ThemeSettingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/theme_title"
            android:textAppearance="@style/TextAppearance.Zette.Title"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_select_title"
                    android:textAppearance="@style/TextAppearance.Zette.H2"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/option_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingBottom="@dimen/space_3"
                        tools:selected="true">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_light_mode"
                            app:tint="@color/mode_option_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:duplicateParentState="true"
                            android:text="@string/theme_mode_light"
                            android:textAppearance="@style/TextAppearance.Zette.Label"
                            android:textColor="@color/mode_option_label" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/option_dark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingBottom="@dimen/space_3">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_dark_mode"
                            app:tint="@color/mode_option_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:duplicateParentState="true"
                            android:text="@string/theme_mode_dark"
                            android:textAppearance="@style/TextAppearance.Zette.Label"
                            android:textColor="@color/mode_option_label" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/option_system"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_mode_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingBottom="@dimen/space_3">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_brightness_auto"
                            app:tint="@color/mode_option_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:duplicateParentState="true"
                            android:text="@string/theme_mode_system"
                            android:textAppearance="@style/TextAppearance.Zette.Label"
                            android:textColor="@color/mode_option_label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_3"
                android:background="@drawable/bg_device_frame"
                android:contentDescription="@string/theme_preview_description"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="247dp"
                    android:layout_height="576dp"
                    app:cardBackgroundColor="@color/surface_canvas"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_preview_light"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/clip_theme_preview_light" />

                    <ImageView
                        android:id="@+id/iv_preview_dark"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/clip_theme_preview_dark" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
