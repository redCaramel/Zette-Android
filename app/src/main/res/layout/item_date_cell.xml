<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_1"
    android:paddingBottom="@dimen/space_1">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.Zette.BodyLarge"
        android:textColor="@color/text_primary"
        tools:text="8" />

    <View
        android:id="@+id/view_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/space_1"
        android:background="@drawable/bg_round_full"
        android:backgroundTint="@color/green_accent"
        android:visibility="invisible" />
</LinearLayout>
