<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    app:cardBackgroundColor="@color/surface_container"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zette.Title"
                android:textColor="@color/text_primary"
                tools:text="팀 프로젝트 회의" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_status"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_round_full"
                    android:backgroundTint="@color/green_mint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Zette.Label"
                        android:textColor="@color/green_brand"
                        tools:text="예약됨" />

                    <ImageView
                        android:id="@+id/iv_status_toggle"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_swap_horiz"
                        app:tint="@color/green_brand" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_complete_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/schedule_complete_action"
                    android:textAppearance="@style/TextAppearance.Zette.Label"
                    android:textColor="@color/green_brand"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_schedule"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Zette.Body"
                android:textColor="@color/text_secondary"
                tools:text="오늘 오후 3:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_place"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Zette.Body"
                android:textColor="@color/text_secondary"
                tools:text="강남역 2번 출구" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_2"
            android:background="@color/border_hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_departure"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_notifications_active"
                app:tint="@color/green_accent" />

            <TextView
                android:id="@+id/tv_departure_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Zette.Label"
                android:textColor="@color/green_brand"
                tools:text="출발 알림 오후 2:15" />

            <TextView
                android:id="@+id/tv_departure_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Zette.Caption"
                android:textColor="@color/text_secondary"
                tools:text="이동 40분" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
