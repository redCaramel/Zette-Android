<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical"
    tools:context=".ui.activity.PermissionStatusActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/permission_title"
            android:textAppearance="@style/TextAppearance.Zette.Title"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_lg"
                android:backgroundTint="@color/surface_container"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_2">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_my_location"
                        app:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_location_title"
                            android:textAppearance="@style/TextAppearance.Zette.Subtitle"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tv_location_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zette.Body"
                            android:textColor="@color/text_secondary"
                            tools:text="앱을 닫아도 위치를 확인해요" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_location_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_3"
                        android:background="@drawable/bg_round_full"
                        android:backgroundTint="@color/green_mint"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.Zette.Label"
                        android:textColor="@color/green_brand"
                        tools:text="허용됨" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_3"
                    android:background="@color/border_hairline" />

                <LinearLayout
                    android:id="@+id/row_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_2">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_notifications"
                        app:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_notification_title"
                            android:textAppearance="@style/TextAppearance.Zette.Subtitle"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tv_notification_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zette.Body"
                            android:textColor="@color/text_secondary"
                            tools:text="앱을 닫아도 위치를 확인해요" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_notification_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_3"
                        android:background="@drawable/bg_round_full"
                        android:backgroundTint="@color/green_mint"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.Zette.Label"
                        android:textColor="@color/green_brand"
                        tools:text="허용됨" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_3"
                    android:background="@color/border_hairline" />

                <LinearLayout
                    android:id="@+id/row_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_2">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_alarm"
                        app:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_alarm_title"
                            android:textAppearance="@style/TextAppearance.Zette.Subtitle"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tv_alarm_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zette.Body"
                            android:textColor="@color/text_secondary"
                            tools:text="앱을 닫아도 위치를 확인해요" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_alarm_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/space_3"
                        android:background="@drawable/bg_round_full"
                        android:backgroundTint="@color/green_mint"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.Zette.Label"
                        android:textColor="@color/green_brand"
                        tools:text="허용됨" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/permission_footer"
                android:textAppearance="@style/TextAppearance.Zette.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
