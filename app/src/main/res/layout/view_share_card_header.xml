<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/static_green_deep"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_logo"
            app:tint="@color/static_green_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/one_mobile_pop"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:text="@string/logo_wordmark"
            android:textColor="@color/static_white"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.Zette.Label"
        android:textColor="@color/static_mint"
        android:textSize="16sp" />
</LinearLayout>
