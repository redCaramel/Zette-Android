<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_lg"
    android:backgroundTint="@color/green_deep"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:id="@+id/layout_departing_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_directions_bus"
            app:tint="@color/text_on_dark_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/hero_departing_eyebrow"
            android:textAppearance="@style/TextAppearance.Zette.Caption"
            android:textColor="@color/text_on_dark_soft" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_departing_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Zette.H2"
        android:textColor="@color/text_on_dark"
        tools:text="472번 버스가\n8분 후 도착해요!" />

    <LinearLayout
        android:id="@+id/layout_departing_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hero_departing_now"
            android:textAppearance="@style/TextAppearance.Zette.Caption"
            android:textColor="@color/text_on_dark_soft" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_departing_arrival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Zette.Display"
                android:textColor="@color/text_on_dark"
                tools:text="8분 후" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/realtime_arrival_suffix"
                android:textAppearance="@style/TextAppearance.Zette.Title"
                android:textColor="@color/text_on_dark" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/layout_departing_loading"
        layout="@layout/view_inline_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/state_pressed_on_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/space_1">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_place"
                app:tint="@color/text_on_dark" />

            <TextView
                android:id="@+id/tv_departing_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Zette.Label"
                android:textColor="@color/text_on_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/state_pressed_on_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/space_1">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_directions_walk"
                app:tint="@color/text_on_dark" />

            <TextView
                android:id="@+id/tv_departing_walk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Zette.Label"
                android:textColor="@color/text_on_dark" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
