<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_lg"
    android:backgroundTint="@color/green_deep"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_event_available"
        app:tint="@color/text_on_dark" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/hero_empty_title"
        android:textAppearance="@style/TextAppearance.Zette.H2"
        android:textColor="@color/text_on_dark" />

    <TextView
        android:id="@+id/tv_empty_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.Zette.Body"
        android:textColor="@color/text_on_dark_soft" />
</LinearLayout>
