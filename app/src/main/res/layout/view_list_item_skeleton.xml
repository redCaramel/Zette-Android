<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/space_3"
    android:paddingBottom="14dp">

    <View
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_round_full"
        android:backgroundTint="@color/state_disabled_fill" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_bone"
            android:backgroundTint="@color/state_disabled_fill" />

        <View
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_bone"
            android:backgroundTint="@color/state_disabled_fill" />
    </LinearLayout>

    <View
        android:layout_width="36dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/space_3"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_disabled_fill" />
</LinearLayout>
