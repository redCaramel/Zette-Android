<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    tools:context=".ui.fragment.HomeFragment">

    <LinearLayout
        android:id="@+id/logo_wrap"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/one_mobile_pop"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:text="@string/logo_wordmark"
            android:textColor="@color/logo_wordmark"
            android:textSize="22sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_wrap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="88dp">

            <include
                android:id="@+id/hero_skeleton"
                layout="@layout/view_hero_skeleton"
                android:layout_width="match_parent"
                android:layout_height="248dp"
                android:visibility="gone" />

            <include
                android:id="@+id/hero_error"
                layout="@layout/view_hero_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/next_departure_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:background="@drawable/bg_round_lg"
                android:backgroundTint="@color/green_deep"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_schedule"
                    app:tint="@color/text_on_dark_soft" />

<TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Zette.H2"
                    android:textColor="@color/text_on_dark"
                    tools:text="오후 3시 00분에\n팀 프로젝트 회의가 있어요!" />

                <LinearLayout
                    android:id="@+id/layout_hero_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_until_departure"
                        android:textAppearance="@style/TextAppearance.Zette.Caption"
                        android:textColor="@color/text_on_dark_soft" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_hero_left_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Zette.Display"
                            android:textColor="@color/text_on_dark"
                            tools:text="1시간 20분" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:text="@string/home_remaining"
                            android:textAppearance="@style/TextAppearance.Zette.Title"
                            android:textColor="@color/text_on_dark" />
                    </LinearLayout>
                </LinearLayout>

                <include
                    android:id="@+id/layout_hero_calculating"
                    layout="@layout/view_inline_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_round_full"
                        android:backgroundTint="@color/state_pressed_on_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_1"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/space_1">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_place"
                            app:tint="@color/text_on_dark" />

                        <TextView
                            android:id="@+id/tv_hero_place"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.Zette.Label"
                            android:textColor="@color/text_on_dark"
                            tools:text="강남역 2번 출구" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:background="@drawable/bg_round_full"
                        android:backgroundTint="@color/state_pressed_on_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_2"
                        android:paddingTop="@dimen/space_1"
                        android:paddingEnd="12dp"
                        android:paddingBottom="@dimen/space_1">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_notifications_active"
                            app:tint="@color/text_on_dark" />

                        <TextView
                            android:id="@+id/tv_hero_departure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.Zette.Label"
                            android:textColor="@color/text_on_dark"
                            tools:text="출발 오후 2:15" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_today_schedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Zette.H2"
                    android:textColor="@color/text_primary"
                    tools:text="오늘의 일정 · 10월 8일 (목)" />

                <TextView
                    android:id="@+id/tv_schedule_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zette.Caption"
                    android:textColor="@color/text_secondary"
                    tools:text="일정 5개" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_schedule_card" />

            <LinearLayout
                android:id="@+id/layout_schedule_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/view_schedule_card_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3" />

                <include
                    layout="@layout/view_schedule_card_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3" />

                <include
                    layout="@layout/view_schedule_card_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
