<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_lg"
    android:backgroundTint="@color/green_deep"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <View
        android:layout_width="110dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_pressed_on_dark" />

    <View
        android:layout_width="220dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_pressed_on_dark" />

    <View
        android:layout_width="180dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_pressed_on_dark" />

    <View
        android:layout_width="90dp"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_pressed_on_dark" />

    <View
        android:layout_width="150dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_skeleton_bone"
        android:backgroundTint="@color/state_pressed_on_dark" />

    <LinearLayout
        android:id="@+id/layout_skeleton_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="120dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/state_pressed_on_dark" />

        <View
            android:layout_width="110dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/state_pressed_on_dark" />
    </LinearLayout>
</LinearLayout>
