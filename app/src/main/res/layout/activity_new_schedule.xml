<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical"
    tools:context=".ui.activity.NewScheduleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/new_schedule_title"
            android:textAppearance="@style/TextAppearance.Zette.Title"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_schedule_info_section"
                android:textAppearance="@style/TextAppearance.Zette.H2"
                android:textColor="@color/text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/new_schedule_name_label"
                app:boxBackgroundColor="@color/surface_container"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                app:boxStrokeColor="@color/green_accent"
                app:helperText="@string/new_schedule_name_helper"
                app:helperTextTextColor="@color/text_secondary"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zette.BodyLarge"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_date"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/new_schedule_date_label"
                    app:boxBackgroundColor="@color/surface_container"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_sm"
                    app:boxStrokeColor="@color/green_accent"
                    app:endIconDrawable="@drawable/ic_expand_more"
                    app:endIconMode="custom"
                    app:endIconTint="@color/text_secondary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Zette.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="10월 8일 (목)" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_time"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:hint="@string/new_schedule_time_label"
                    app:boxBackgroundColor="@color/surface_container"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_sm"
                    app:boxStrokeColor="@color/green_accent"
                    app:endIconDrawable="@drawable/ic_expand_more"
                    app:endIconMode="custom"
                    app:endIconTint="@color/text_secondary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Zette.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="오후 3:00" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/new_schedule_place_section"
                android:textAppearance="@style/TextAppearance.Zette.H2"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/layout_selected_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_selected_place"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/iv_selected_place"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_add_location_alt"
                    app:tint="@color/selected_place_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:text="@string/new_schedule_selected_place"
                        android:textAppearance="@style/TextAppearance.Zette.LabelSmall"
                        android:textColor="@color/selected_place_label" />

                    <TextView
                        android:id="@+id/tv_selected_place_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Zette.Subtitle"
                        android:textColor="@color/text_primary"
                        android:visibility="gone"
                        tools:text="강남역 2번 출구"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_selected_place_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/new_schedule_selected_place_empty"
                        android:textAppearance="@style/TextAppearance.Zette.Body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_selected_place_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_check_circle"
                    app:tint="@color/green_brand" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_2">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/new_schedule_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Zette.BodyLarge"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled" />

                <ImageButton
                    android:id="@+id/btn_search_clear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/new_schedule_search_clear"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layout_search_loading"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true"
                            android:indeterminateDrawable="@drawable/loading_spin"
                            android:indeterminateDuration="1000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:text="@string/new_schedule_search_loading"
                            android:textAppearance="@style/TextAppearance.Zette.Body"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_search_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_place_search_result"
                        tools:visibility="visible" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layout_nonsupport_band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:background="@drawable/bg_round_lg"
                android:backgroundTint="@color/green_deep"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule_nonsupport_heading"
                    android:textAppearance="@style/TextAppearance.Zette.H2"
                    android:textColor="@color/text_on_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/new_schedule_nonsupport_body"
                    android:textAppearance="@style/TextAppearance.Zette.Body"
                    android:textColor="@color/text_on_dark_soft" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/new_schedule_route_section"
                android:textAppearance="@style/TextAppearance.Zette.H2"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/new_schedule_route_type"
                android:textAppearance="@style/TextAppearance.Zette.Label"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_route_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_route_min_time"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule_route_min_time" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_route_min_walk"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule_route_min_walk" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_route_min_transfer"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule_route_min_transfer" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/new_schedule_arrival_buffer"
                android:textAppearance="@style/TextAppearance.Zette.Label"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_arrival_buffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_buffer_none"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule_buffer_none" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_buffer_5"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5분" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_buffer_10"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="10분" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_buffer_15"
                    style="@style/Widget.Zette.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="15분" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estimated_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_directions_transit"
                        app:tint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_estimated_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_schedule_estimate_label"
                            android:textAppearance="@style/TextAppearance.Zette.Caption"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_estimated_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Zette.Subtitle"
                            android:textColor="@color/text_primary"
                            tools:text="약 40분이 소요돼요" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/new_schedule_route_note"
                android:textAppearance="@style/TextAppearance.Zette.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Zette.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_schedule_save" />
    </FrameLayout>
</LinearLayout>
