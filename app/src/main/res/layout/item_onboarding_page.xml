<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_illustration"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_3"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/onboarding_tutorial_1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/border_hairline" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/border_hairline" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_round_full"
            android:backgroundTint="@color/border_hairline" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Zette.H1"
        android:textColor="@color/text_primary"
        tools:text="@string/onboarding_1_title" />

    <TextView
        android:id="@+id/tv_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minLines="2"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Zette.Body"
        android:textColor="@color/text_secondary"
        tools:text="@string/onboarding_1_body" />
</LinearLayout>
